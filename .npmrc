# pi installs git packages with a plain `npm install --omit=dev` in the clone.
# The bundled companion extensions declare @earendil-works/pi-* peers (one of
# them pinned to ^0.84), which pi itself provides through loader aliases.
# Without this, npm would try to install a second, older pi core as a peer.
# Matches the --legacy-peer-deps pi already uses for npm-sourced packages.
legacy-peer-deps=true
