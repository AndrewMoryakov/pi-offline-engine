# pi installs git packages with a plain `npm install --omit=dev` in the clone.
# The bundled companion extensions declare @earendil-works/pi-* peers (one of
# them pinned to ^0.84), which pi itself provides through loader aliases.
# Without this, npm would try to install a second, older pi core as a peer.
# Matches the --legacy-peer-deps pi already uses for npm-sourced packages.
legacy-peer-deps=true

# onnxruntime-node (pulled in by pi-knowledge through @huggingface/transformers)
# runs a postinstall on Linux x64 that downloads a CUDA build from the
# microsoft/onnxruntime GitHub release page and fails the whole install when
# that download does not answer 200. The asset for v1.21.0 returns 404 (checked
# 2026-11-19), so a fresh `pi install` on Linux x64 stops with "Failed to
# download the binaries: 404 Not Found". pi-knowledge never selects a device for
# its embedding and reranking pipelines, so the CUDA execution provider is not
# requested; the script reads this key through
# npm_config_onnxruntime_node_install_cuda and skips the download. npm 9, 10 and
# 11 pass the key on; npm 11 warns that an unknown config key "will stop working
# in the next major version of npm", so this needs another route by then.
onnxruntime-node-install-cuda=skip
